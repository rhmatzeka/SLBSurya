---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/ui/Photo.astro';
import Icon from '../components/ui/Icon.astro';
import Flower from '../components/ui/Flower.astro';
import { allPhotos, galleryCategories, type PhotoKey } from '../content/site';

const groups = await Promise.all(
  galleryCategories.map(async (cat) => {
    const photos = allPhotos.filter((p) => p.category === cat.id);
    const items = await Promise.all(
      photos.map(async (p) => {
        const full = await getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'webp', quality: 78 });
        return { ...p, full: full.src };
      }),
    );
    return { ...cat, items };
  }),
);
const total = allPhotos.length;
---

<BaseLayout title="Galeri Foto" description="Galeri foto kegiatan, program vokasi, sarana, serta karya dan prestasi siswa SLB Surya Wiyata.">
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <Flower class="absolute -right-16 top-6 h-56 w-56 fill-navy-700/70" />
    <Flower class="absolute -bottom-20 right-40 h-40 w-40 fill-navy-700/60" />
    <div class="container-page relative py-14 sm:py-20">
      <a href="/" class="inline-flex items-center gap-2 text-sm text-white/80 hover:text-yellow-400">
        <Icon name="arrow-left" size={16} /> Kembali ke beranda
      </a>
      <h1 class="h-display mt-6">Galeri Foto</h1>
      <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-white/80">
        {total} foto kegiatan, program vokasi, sarana, serta karya dan prestasi siswa SLB Surya Wiyata.
      </p>
      <nav aria-label="Kategori galeri" class="mt-8 flex flex-wrap gap-2">
        {
          groups.map((g) => (
            <a href={`#${g.id}`} class="btn-outline-light py-2">
              {g.label}
              <span class="text-white/60">{g.items.length}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <div class="bg-cream py-14 sm:py-20" data-gallery>
    <div class="container-page space-y-16 sm:space-y-20">
      {
        groups.map((g) => (
          <section id={g.id} aria-labelledby={`${g.id}-title`}>
            <h2 id={`${g.id}-title`} class="rule-dashed pb-4 font-serif text-[1.9rem] text-navy-700 sm:text-[2.3rem]">
              {g.label}
            </h2>
            <ul class="mt-6 columns-2 gap-3 sm:columns-3 lg:columns-4">
              {g.items.map((p) => (
                <li class="mb-3 break-inside-avoid">
                  <button
                    type="button"
                    class="group relative block w-full overflow-hidden rounded-lg bg-blue-100"
                    data-full={p.full}
                    data-caption={p.alt}
                    aria-label={`Perbesar foto: ${p.alt}`}
                  >
                    <Photo
                      id={p.key as PhotoKey}
                      sizes="(min-width: 1024px) 290px, (min-width: 640px) 33vw, 50vw"
                      widths={[300, 480, 640]}
                      class="h-auto transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>

  <dialog
    class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink/95 p-0 text-white backdrop:bg-transparent"
    aria-label="Foto diperbesar"
    data-lightbox
  >
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between px-4 py-3 text-sm text-white/80">
        <span data-lb-count></span>
        <button type="button" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Tutup" data-lb-close>
          <Icon name="close" size={20} />
        </button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-16">
        <img alt="" class="max-h-full max-w-full rounded-md object-contain" data-lb-img />
        <button
          type="button"
          class="absolute left-2 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-ink/80 bg-yellow-400 text-ink sm:left-4"
          aria-label="Foto sebelumnya"
          data-lb-prev
        >
          <Icon name="chevron-left" size={20} strokeWidth={2.4} />
        </button>
        <button
          type="button"
          class="absolute right-2 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-ink/80 bg-yellow-400 text-ink sm:right-4"
          aria-label="Foto berikutnya"
          data-lb-next
        >
          <Icon name="chevron-right" size={20} strokeWidth={2.4} />
        </button>
      </div>
      <p class="px-4 py-4 text-center text-[15px] text-white/85" data-lb-caption></p>
    </div>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery] [data-full]')];
  if (dialog && buttons.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + buttons.length) % buttons.length;
      const b = buttons[index];
      img.src = b.dataset.full ?? '';
      img.alt = b.dataset.caption ?? '';
      caption.textContent = b.dataset.caption ?? '';
      count.textContent = `${index + 1} / ${buttons.length}`;
    };
    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        opener = b;
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
