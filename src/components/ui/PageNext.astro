---
/** Kartu "Selanjutnya" di akhir halaman, supaya pengunjung mengikuti alur jelajah dengan mudah. */
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { pageByHref } from '../../content/site';

interface Props {
  href: string;
}

const page = pageByHref(Astro.props.href);
---

<section class="bg-cream pb-14 pt-4 sm:pb-24" aria-label="Halaman selanjutnya">
  <div class="container-page">
    <a
      href={page.href}
      class="group grid overflow-hidden rounded-2xl bg-navy-700 text-white shadow-[0_24px_60px_-30px_rgba(10,58,96,0.6)] transition-colors hover:bg-navy-900 sm:grid-cols-[0.9fr_1.1fr]"
    >
      <div class="aspect-[16/9] overflow-hidden sm:aspect-auto sm:min-h-[260px]">
        <Photo id={page.image} sizes="(min-width: 640px) 520px, 100vw" class="transition-transform duration-700 group-hover:scale-105" />
      </div>
      <div class="flex flex-col justify-center p-6 sm:p-10">
        <p class="text-[13px] font-medium text-yellow-400">Selanjutnya</p>
        <p class="mt-2 font-serif text-[1.8rem] leading-tight sm:text-[2.4rem]">{page.title}</p>
        <p class="mt-3 max-w-md text-[15px] leading-relaxed text-white/80">{page.description}</p>
        <span class="mt-6 inline-flex items-center gap-2 self-start rounded-full bg-yellow-400 px-5 py-2.5 text-sm font-semibold text-ink transition-transform group-hover:translate-x-1">
          Buka halaman
          <Icon name="arrow-right" size={16} />
        </span>
      </div>
    </a>
  </div>
</section>
