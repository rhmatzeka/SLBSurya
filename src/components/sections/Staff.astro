---
import { leadership, teachers, staffGroups } from '../../content/site';

const initials = (name: string) =>
  name
    .split(',')[0]
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('');
---

<section id="guru" class="bg-white py-20 sm:py-24" aria-labelledby="guru-title">
  <div class="container-page">
    <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">Guru & Tenaga Kependidikan</p>
        <h2 id="guru-title" class="h-section mt-4">Didampingi tim yang sabar dan berdedikasi.</h2>
        <p class="mt-5 text-[16px] leading-[1.75] text-ink/85">
          Susunan guru dan tenaga kependidikan SLB BC Surya Wiyata tahun ajaran 2026/2027.
        </p>
      </div>

      <ul class="grid gap-4 self-end sm:grid-cols-2" data-reveal>
        {
          leadership.map((p) => (
            <li class="flex items-center gap-4 rounded-xl bg-blue-50 p-5 ring-1 ring-blue-100">
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-navy-700 font-serif text-lg text-yellow-400">
                {initials(p.name)}
              </span>
              <span>
                <span class="block text-[13px] font-medium text-blue-600">{p.role}</span>
                <span class="mt-0.5 block font-serif text-[1.15rem] leading-snug">{p.name}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
      <div data-reveal>
        <h3 class="rule-dashed pb-3 font-serif text-2xl text-navy-700">Guru</h3>
        <ul class="mt-2 grid sm:grid-cols-2 sm:gap-x-8">
          {
            teachers.map((t) => (
              <li class="flex items-center gap-3 border-b border-cream-200 py-3 text-[15px]">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500" aria-hidden="true" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-8" data-reveal>
        {
          staffGroups.map((g) => (
            <div>
              <h3 class="rule-dashed pb-3 font-serif text-xl text-navy-700">{g.role}</h3>
              <ul class="mt-2">
                {g.people.map((p) => (
                  <li class="border-b border-cream-200 py-2.5 text-[15px]">{p}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
