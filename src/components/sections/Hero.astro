---
import Photo from '../ui/Photo.astro';
import Flower from '../ui/Flower.astro';
import Icon from '../ui/Icon.astro';
import type { PhotoKey } from '../../content/site';

const slides: { id: PhotoKey; position?: string }[] = [
  { id: 'tentang/siswa-bersama', position: '50% 40%' },
  { id: 'kegiatan/wisata-rombongan', position: '50% 70%' },
  { id: 'kegiatan/pentas-seni', position: '50% 55%' },
  { id: 'kegiatan/kemah', position: '50% 50%' },
  { id: 'kegiatan/outing-3', position: '50% 50%' },
];

// Bunga dekoratif di latar (pengganti siluet pohon referensi)
const flowers = [
  { x: '-3%', y: '48%', s: 150 },
  { x: '6%', y: '72%', s: 110 },
  { x: '-1%', y: '88%', s: 90 },
  { x: '88%', y: '30%', s: 120 },
  { x: '94%', y: '60%', s: 160 },
  { x: '84%', y: '82%', s: 100 },
];
---

<section class="relative flex min-h-[calc(100svh-6rem)] flex-col overflow-hidden bg-navy-900 text-white sm:block sm:min-h-0" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
    {
      flowers.map((f) => (
        <div class="absolute" style={`left:${f.x};top:${f.y};width:${f.s}px;height:${f.s}px`}>
          <Flower class="h-full w-full fill-navy-700/70" />
        </div>
      ))
    }
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 lg:hidden" aria-hidden="true">
    {
      [
        { x: -4, s: 74, y: -22 },
        { x: 14, s: 46, y: -10 },
        { x: 27, s: 60, y: -26 },
        { x: 44, s: 40, y: -8 },
        { x: 57, s: 66, y: -24 },
        { x: 74, s: 48, y: -12 },
        { x: 86, s: 80, y: -30 },
      ].map((f) => (
        <Flower
          class="absolute fill-navy-700/70"
          ring
          ringClass="fill-navy-900/50"
          style={`left:${f.x}%;bottom:${f.y}px;width:${f.s}px;height:${f.s}px`}
        />
      ))
    }
  </div>

  <div class="container-page relative grid flex-1 content-center items-center gap-7 pb-24 pt-3 sm:gap-10 sm:pb-14 sm:pt-10 lg:grid-cols-[0.82fr_1.18fr] lg:gap-6 lg:pb-16 lg:pt-10">
    <div class="relative z-10 lg:-mr-24">
      <p class="font-serif text-[15px] text-white/80 sm:text-lg">Sekolah Luar Biasa sejak 1972</p>
      <h1 id="hero-title" class="h-display mt-2 max-w-[16ch] sm:mt-4 sm:max-w-[13ch]">
        Membawa harapan untuk masa depan yang lebih cerah.
      </h1>
      <p class="mt-4 max-w-md text-[15px] leading-relaxed text-white/80 sm:mt-6 sm:text-[17px]">
        Pendidikan yang adaptif dan penuh kasih untuk anak tunarungu, tunagrahita, autisme, dan down syndrome, di Bekasi dan
        Jakarta Timur.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
        <a href="#kontak" class="btn-yellow border-transparent px-5 py-2.5 sm:px-6 sm:py-3 sm:text-[15px]">
          Hubungi Kami
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="#tentang" class="btn-outline-light px-5 py-2.5 sm:px-6 sm:py-3 sm:text-[15px]">Kenali Kami</a>
      </div>

      <div class="mt-7 flex gap-2 lg:mt-12" role="tablist" aria-label="Pilih foto" data-hero-dots>
        {
          slides.map((_, i) => (
            <button
              type="button"
              role="tab"
              aria-label={`Foto ${i + 1}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              class="h-1 w-6 rounded-full bg-white/30 transition-colors aria-selected:bg-yellow-400"
              data-hero-dot={i}
            />
          ))
        }
      </div>
    </div>

    <div class="relative order-first lg:order-none">
      <div class="relative aspect-[16/10.5] overflow-hidden rounded-xl bg-navy-700 shadow-2xl shadow-black/20 sm:rounded-2xl lg:aspect-auto lg:h-[500px]">
        {
          slides.map((s, i) => (
            <div
              class:list={[
                'absolute inset-0 transition-opacity duration-1000',
                i === 0 ? 'opacity-100' : 'hidden opacity-0',
              ]}
              data-hero-slide={i}
            >
              <Photo
                id={s.id}
                position={s.position}
                priority={i === 0}
                sizes="(min-width: 1200px) 680px, (min-width: 1024px) 58vw, 100vw"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>('[data-hero-slide]')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
  let current = 0;
  let timer: number | undefined;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const show = (n: number) => {
    current = (n + slides.length) % slides.length;
    prepare(current);
    prepare(current + 1);
    slides.forEach((s, i) => {
      s.classList.toggle('opacity-100', i === current);
      s.classList.toggle('opacity-0', i !== current);
    });
    dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === current)));
  };
  // Foto berikutnya baru dimuat tepat sebelum gilirannya tampil, supaya foto pertama (LCP) tidak berebut bandwidth
  const prepare = (n: number) => slides[(n + slides.length) % slides.length]?.classList.remove('hidden');

  const start = () => {
    if (reduce) return;
    window.clearInterval(timer);
    timer = window.setInterval(() => show(current + 1), 5500);
    window.setTimeout(() => prepare(current + 1), 3000);
  };
  dots.forEach((d, i) =>
    d.addEventListener('click', () => {
      show(i);
      start();
    }),
  );
  document.addEventListener('visibilitychange', () => (document.hidden ? window.clearInterval(timer) : start()));
  start();
</script>
