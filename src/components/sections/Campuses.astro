---
import Icon from '../ui/Icon.astro';
import { campuses, mapsUrl } from '../../content/site';
---

<section id="kontak" class="bg-cream py-14 sm:py-24" aria-labelledby="kontak-title">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Unit Sekolah & Kontak</p>
      <h2 id="kontak-title" class="h-section mt-4">Dua unit, satu keluarga Surya Wiyata.</h2>
      <p class="mt-5 text-[16px] leading-[1.75] text-ink/85">
        Silakan hubungi kami lewat email atau datang langsung untuk berkenalan dengan guru dan melihat lingkungan sekolah.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        campuses.map((c, i) => (
          <article class="flex flex-col overflow-hidden rounded-xl bg-white shadow-[0_18px_40px_-26px_rgba(10,58,96,0.35)] ring-1 ring-cream-200" data-reveal>
            <div class:list={['flex flex-wrap items-center justify-between gap-3 px-6 py-5', i === 0 ? 'bg-navy-700 text-white' : 'bg-blue-600 text-white']}>
              <div>
                <p class="text-[13px] opacity-80">{c.area}</p>
                <h3 class="mt-1 font-serif text-[1.6rem] leading-tight">{c.name}</h3>
              </div>
              <span class="whitespace-nowrap rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-ink">Akreditasi {c.accreditation}</span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <dl class="grid gap-4 text-[15px]">
                <div class="flex gap-3">
                  <dt class="mt-0.5 text-blue-600">
                    <Icon name="pin" size={18} />
                    <span class="sr-only">Alamat</span>
                  </dt>
                  <dd class="leading-relaxed">
                    {c.address.map((line) => <span class="block">{line}</span>)}
                  </dd>
                </div>
                <div class="flex gap-3">
                  <dt class="mt-0.5 text-blue-600">
                    <Icon name="mail" size={18} />
                    <span class="sr-only">Email</span>
                  </dt>
                  <dd>
                    <a href={`mailto:${c.email}`} class="break-all underline decoration-ink/30 underline-offset-4 hover:text-blue-600">
                      {c.email}
                    </a>
                  </dd>
                </div>
                <div class="flex gap-3">
                  <dt class="mt-0.5 text-blue-600">
                    <Icon name="shield" size={18} />
                    <span class="sr-only">NPSN</span>
                  </dt>
                  <dd>NPSN {c.npsn}</dd>
                </div>
              </dl>

              <details class="group mt-5 rounded-lg bg-cream px-4 py-3 text-[14px]">
                <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-navy-700 [&::-webkit-details-marker]:hidden">
                  Lihat legalitas
                  <Icon name="chevron-right" size={16} class="transition-transform group-open:rotate-90" />
                </summary>
                <dl class="mt-3 grid gap-2.5 text-ink/85">
                  <div><dt class="font-medium text-ink">Domisili</dt><dd>{c.domicile}</dd></div>
                  <div><dt class="font-medium text-ink">Perizinan</dt><dd class="break-words">{c.license}</dd></div>
                  <div><dt class="font-medium text-ink">Yayasan</dt><dd>{c.foundation}</dd></div>
                  <div><dt class="font-medium text-ink">Akta Yayasan</dt><dd>{c.deed}</dd></div>
                  <div><dt class="font-medium text-ink">Pengukuhan</dt><dd>{c.ratification}</dd></div>
                </dl>
              </details>

              <div class="mt-6 flex flex-wrap gap-2 pt-1">
                <a href={mapsUrl(c.mapsQuery)} target="_blank" rel="noopener" class="btn-yellow">
                  <Icon name="pin" size={16} />
                  Buka di Google Maps
                </a>
                <a href={`mailto:${c.email}`} class="btn-outline">
                  <Icon name="mail" size={16} />
                  Kirim Email
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
