---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo.png';
import Icon from '../ui/Icon.astro';
import { campuses, nav, socials } from '../../content/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<div class="bg-navy-950 text-[11px] text-white/85 sm:text-[13px]">
  <div class="container-page no-scrollbar flex h-8 items-center justify-center gap-4 overflow-x-auto whitespace-nowrap sm:h-9 sm:justify-end sm:gap-6">
    {
      campuses.map((c) => (
        <a href={`mailto:${c.email}`} class="hidden items-center gap-1.5 hover:text-yellow-400 sm:inline-flex">
          <Icon name="mail" size={14} />
          {c.short}
        </a>
      ))
    }
    {
      socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-yellow-400">
          <Icon name={s.id} size={14} />
          {s.label}
        </a>
      ))
    }
    <a href="/galeri" class="inline-flex items-center gap-1.5 hover:text-yellow-400">
      <Icon name="image" size={14} />
      Galeri
    </a>
  </div>
</div>

<header class="sticky top-0 z-50 bg-navy-900 text-white [view-transition-name:site-header]" data-header>
  <div class="container-page flex h-16 items-center justify-between gap-4 sm:h-[72px] sm:gap-6">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label="SLB Surya Wiyata, ke beranda">
      <Image src={logo} alt="" width={48} height={48} densities={[1, 2, 3]} class="h-10 w-10 sm:h-12 sm:w-12" loading="eager" />
      <span class="leading-none">
        <span class="block font-serif text-[1.05rem] tracking-tight sm:text-[1.15rem]">SLB Surya Wiyata</span>
        <span class="mt-1 block text-[11px] tracking-wide text-white/70">Sejak 1972</span>
      </span>
    </a>

    <nav aria-label="Navigasi utama" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[15px] font-medium">
        {
          nav.map((n) => (
            <li>
              <a
                href={n.href}
                aria-current={isActive(n.href) ? 'page' : undefined}
                class="relative py-2 text-white/90 transition-colors hover:text-yellow-400 aria-[current=page]:text-yellow-400 aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-0.5 aria-[current=page]:after:h-0.5 aria-[current=page]:after:rounded-full aria-[current=page]:after:bg-yellow-400"
              >
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/kontak" class="btn-yellow hidden border-transparent sm:inline-flex">Hubungi Kami</a>
      <a
        href="/kontak"
        class="grid h-10 w-10 place-items-center rounded-full border border-white/40 text-white hover:border-white sm:hidden"
        aria-label="Hubungi kami"
      >
        <Icon name="mail" size={18} />
      </a>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full bg-yellow-400 text-ink hover:bg-yellow-300 sm:inline-flex sm:h-auto sm:w-auto sm:items-center sm:gap-2 sm:px-5 sm:py-2.5 sm:text-sm sm:font-semibold lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-menu-toggle
      >
        <span data-menu-label class="sr-only sm:not-sr-only">Menu</span>
        <Icon name="menu" size={18} class="menu-open-icon" />
        <Icon name="close" size={18} class="menu-close-icon hidden" />
      </button>
    </div>
  </div>

  <div id="menu-mobile" class="hidden border-t border-white/10 bg-navy-900 lg:hidden" data-menu>
    <nav aria-label="Navigasi seluler" class="container-page py-6">
      <ul class="divide-y divide-white/10">
        {
          [{ label: 'Beranda', href: '/' }, ...nav].map((n) => (
            <li>
              <a
                href={n.href}
                aria-current={(n.href === '/' ? path === '/' : isActive(n.href)) ? 'page' : undefined}
                class="flex items-center justify-between py-3.5 font-serif text-2xl aria-[current=page]:text-yellow-400"
                data-menu-link
              >
                {n.label}
                <Icon name="chevron-right" size={20} class="text-yellow-400" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="btn-outline-light py-2">
              <Icon name={s.id} size={16} />
              {s.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      btn.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
      btn.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
      const label = btn.querySelector('[data-menu-label]');
      if (label) label.textContent = open ? 'Tutup' : 'Menu';
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
  }
</script>
