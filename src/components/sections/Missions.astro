---
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
import { missions } from '../../content/site';
---

<section id="visi-misi" class="overflow-hidden bg-cream py-20 sm:py-24" aria-labelledby="misi-title">
  <div class="container-page text-center" data-reveal>
    <p class="eyebrow">Misi Kami</p>
    <h2 id="misi-title" class="mx-auto mt-4 max-w-[24ch] font-serif text-[2rem] leading-[1.15] text-navy-700 sm:text-[2.7rem]">
      Lima misi yang menuntun kami menemukan dan merawat potensi unik setiap anak.
    </h2>
  </div>

  <div class="relative mt-12" data-carousel>
    <ul
      class="no-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-[max(1rem,calc(50vw-190px))] pb-2 sm:gap-8 sm:px-[calc(50vw-200px)]"
      data-carousel-track
      aria-label="Misi SLB Surya Wiyata"
    >
      {
        missions.map((m, i) => (
          <li class="w-[min(80vw,380px)] shrink-0 snap-center sm:w-[400px]" data-carousel-item>
            <article class="relative">
              <div class="aspect-[1/1.02] overflow-hidden rounded-t-full rounded-b-xl bg-blue-100">
                <Photo id={m.image} sizes="400px" widths={[400, 640, 800]} />
              </div>
              <div class="relative -mt-24 mx-4 rounded-xl bg-white px-5 py-6 text-center shadow-[0_18px_40px_-22px_rgba(10,58,96,0.35)] sm:mx-6">
                <p class="text-xs font-semibold tracking-wider text-blue-600">MISI {i + 1}</p>
                <h3 class="mt-1 font-serif text-[1.7rem] leading-tight text-ink sm:text-3xl">{m.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-muted">{m.text}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      class="absolute left-3 top-[34%] grid h-12 w-12 place-items-center rounded-full border border-ink/80 bg-yellow-400 text-ink shadow-md transition hover:bg-yellow-300 disabled:opacity-40 sm:left-[calc(50vw-280px)] sm:h-14 sm:w-14 lg:left-[calc(50vw-330px)]"
      aria-label="Misi sebelumnya"
      data-carousel-prev
    >
      <Icon name="chevron-left" size={20} strokeWidth={2.4} />
    </button>
    <button
      type="button"
      class="absolute right-3 top-[34%] grid h-12 w-12 place-items-center rounded-full border border-ink/80 bg-yellow-400 text-ink shadow-md transition hover:bg-yellow-300 disabled:opacity-40 sm:right-[calc(50vw-280px)] sm:h-14 sm:w-14 lg:right-[calc(50vw-330px)]"
      aria-label="Misi berikutnya"
      data-carousel-next
    >
      <Icon name="chevron-right" size={20} strokeWidth={2.4} />
    </button>

    <div class="mt-8 flex justify-center gap-1.5" aria-hidden="true">
      {missions.map((_, i) => <span class:list={['h-1 w-6 rounded-full transition-colors', i === 0 ? 'bg-blue-500' : 'bg-line']} data-carousel-dot />)}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-carousel-item]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-carousel-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !items.length) return;

    const activeIndex = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let dist = Infinity;
      items.forEach((it, i) => {
        const d = Math.abs(it.offsetLeft + it.offsetWidth / 2 - center);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    };
    const go = (i: number) => {
      const it = items[Math.max(0, Math.min(items.length - 1, i))];
      track.scrollTo({ left: it.offsetLeft + it.offsetWidth / 2 - track.clientWidth / 2 });
    };
    const update = () => {
      const a = activeIndex();
      dots.forEach((d, i) => {
        d.classList.toggle('bg-blue-500', i === a);
        d.classList.toggle('bg-line', i !== a);
      });
      if (prev) prev.disabled = a === 0;
      if (next) next.disabled = a === items.length - 1;
    };
    prev?.addEventListener('click', () => go(activeIndex() - 1));
    next?.addEventListener('click', () => go(activeIndex() + 1));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    update();
  });
</script>
