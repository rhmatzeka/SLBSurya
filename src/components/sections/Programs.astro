---
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
import Flower from '../ui/Flower.astro';
import { programs } from '../../content/site';
---

<section id="program" class="bg-cream py-14 sm:py-24" aria-labelledby="program-title">
  <div class="container-page grid gap-16 lg:grid-cols-[0.8fr_1fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
      <p class="eyebrow">Program Vokasi</p>
      <h2 id="program-title" class="h-section mt-4">Keterampilan nyata sebagai bekal hidup yang mandiri.</h2>
      <ol class="mt-10 hidden space-y-4 lg:block" data-program-nav>
        {
          programs.map((p, i) => (
            <li>
              <a
                href={`#${p.id}`}
                class="group flex items-start gap-4 font-serif text-[1.1rem] leading-snug text-ink/80 transition-colors hover:text-navy-700 aria-[current=true]:text-navy-700"
                aria-current={i === 0 ? 'true' : 'false'}
                data-program-link={p.id}
              >
                <span class="mt-[7px] h-2.5 w-2.5 shrink-0 rounded-full bg-line ring-4 ring-transparent transition-all group-aria-[current=true]:bg-transparent group-aria-[current=true]:ring-yellow-400 group-aria-[current=true]:ring-[3px]" />
                {p.title}
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="relative space-y-12 sm:space-y-24">
      <Flower class="absolute -top-11 left-3 h-16 w-16 fill-blue-500 sm:-top-14 sm:left-10 sm:h-20 sm:w-20" ring ringClass="fill-yellow-400" />
      {
        programs.map((p) => (
          <article id={p.id} class="relative" data-program-card={p.id} data-reveal>
            <div class="aspect-[4/3] overflow-hidden rounded-xl sm:aspect-[1.45/1] lg:-mr-12">
              <Photo id={p.images[0]} sizes="(min-width: 1024px) 640px, 100vw" />
            </div>
            <div class="relative -mt-14 ml-2 mr-2 rounded-xl bg-white p-5 shadow-[0_18px_40px_-20px_rgba(10,58,96,0.25)] sm:-mt-36 sm:ml-20 sm:mr-8 sm:p-7 lg:mr-0">
              <h3 class="font-serif text-[1.3rem] leading-tight text-blue-600 sm:text-[1.65rem]">{p.title}</h3>
              <p class="mt-2.5 text-[14px] leading-relaxed text-muted sm:mt-3 sm:text-[15px]">{p.text}</p>
              {(p.schedule || p.mentor) && (
                <ul class="mt-4 flex flex-wrap gap-2 text-[13px]">
                  {p.schedule && (
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-yellow-100 px-3 py-1 font-medium text-ink">
                      <Icon name="clock" size={14} />
                      {p.schedule}
                    </li>
                  )}
                  {p.mentor && (
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 font-medium text-navy-700">
                      <Icon name="user" size={14} />
                      {p.mentor}
                    </li>
                  )}
                </ul>
              )}
              <a href="/galeri#vokasi" class="btn-outline mt-5 px-4 py-2 text-[13px] sm:mt-6 sm:px-5 sm:py-2.5 sm:text-sm">
                Lihat Foto
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-program-link]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-program-card]')];
  if (links.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const id = (e.target as HTMLElement).dataset.programCard;
          links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.programLink === id)));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    cards.forEach((c) => io.observe(c));
  }
</script>
