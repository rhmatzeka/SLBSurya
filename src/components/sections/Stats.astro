---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo.png';
import Icon from '../ui/Icon.astro';
import Flower from '../ui/Flower.astro';
import { stats } from '../../content/site';

const iconTone = ['bg-blue-500', 'bg-navy-700', 'bg-yellow-400 text-ink', 'bg-blue-600'];
---

<section class="relative overflow-hidden bg-blue-50 py-16 sm:py-20" aria-labelledby="angka-title">
  <div class="container-page grid items-center gap-12 lg:grid-cols-[1fr_300px]">
    <div>
      <h2 id="angka-title" class="rule-dashed pb-4 font-serif text-2xl text-blue-600 sm:text-[1.7rem]" data-reveal>
        Surya Wiyata dalam Angka
      </h2>
      <ul class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2">
        {
          stats.map((s, i) => (
            <li class="flex gap-3" data-reveal>
              <span class:list={['mt-3 grid h-8 w-8 shrink-0 place-items-center rounded-full text-white sm:mt-5', iconTone[i]]}>
                <Icon name={s.icon} size={16} strokeWidth={2.2} />
              </span>
              <div>
                <p class="font-serif text-6xl leading-none tracking-tight text-navy-700 sm:text-7xl">{s.value}</p>
                <p class="mt-3 max-w-[30ch] text-sm leading-relaxed text-ink/80">{s.label}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Lambang (pengganti maskot burung hantu referensi) -->
    <div class="relative mx-auto hidden h-[300px] w-[300px] lg:block" aria-hidden="true" data-reveal>
      <Flower class="absolute inset-0 h-full w-full fill-blue-500" ring ringClass="fill-yellow-400" />
      <div class="absolute inset-[22%] grid place-items-center rounded-full bg-white shadow-lg shadow-navy-900/10">
        <Image src={logo} alt="" width={150} height={150} densities={[1, 2]} class="h-[150px] w-[150px]" />
      </div>
    </div>
  </div>
</section>
