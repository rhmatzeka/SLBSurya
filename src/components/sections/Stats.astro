---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo.png';
import Icon from '../ui/Icon.astro';
import Flower from '../ui/Flower.astro';
import { stats } from '../../content/site';

const iconTone = ['bg-blue-500', 'bg-navy-700', 'bg-yellow-400 text-ink', 'bg-blue-600'];
---

<section class="relative overflow-hidden bg-blue-50 py-12 sm:py-20" aria-labelledby="angka-title">
  <div class="container-page grid items-center gap-8 lg:grid-cols-[1fr_300px] lg:gap-12">
    <div>
      <h2 id="angka-title" class="rule-dashed pb-4 font-serif text-xl text-blue-600 sm:text-[1.7rem]" data-reveal>
        Surya Wiyata dalam Angka
      </h2>
      <ul class="mt-8 grid gap-x-10 gap-y-7 sm:mt-10 sm:grid-cols-2 sm:gap-y-10">
        {
          stats.map((s, i) => (
            <li class="flex gap-3" data-reveal>
              <span class:list={['mt-1.5 grid h-7 w-7 shrink-0 place-items-center rounded-full text-white sm:mt-5 sm:h-8 sm:w-8', iconTone[i]]}>
                <Icon name={s.icon} size={16} strokeWidth={2.2} />
              </span>
              <div>
                <p class="font-serif text-[2.7rem] leading-none tracking-tight text-navy-700 sm:text-7xl">{s.value}</p>
                <p class="mt-2 max-w-[34ch] text-[13px] leading-relaxed text-ink/80 sm:mt-3 sm:text-sm">{s.label}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Lambang (pengganti maskot burung hantu referensi) -->
    <div class="relative h-[190px] w-[190px] sm:h-[240px] sm:w-[240px] lg:mx-auto lg:h-[300px] lg:w-[300px]" aria-hidden="true" data-reveal>
      <Flower class="absolute inset-0 h-full w-full fill-blue-500" ring ringClass="fill-yellow-400" />
      <div class="absolute inset-[22%] grid place-items-center rounded-full bg-white shadow-lg shadow-navy-900/10">
        <Image src={logo} alt="" width={150} height={150} densities={[1, 2]} class="h-auto w-[88%]" />
      </div>
    </div>
  </div>
</section>
