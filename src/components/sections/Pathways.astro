---
/** Beranda: kartu jelajah menuju halaman-halaman utama (gaya "Chart a path" di referensi). */
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
import { pageByHref } from '../../content/site';

const cards = [
  { page: pageByHref('/tentang'), tone: 'bg-navy-700 text-white' },
  { page: pageByHref('/program'), tone: 'bg-blue-600 text-white' },
  { page: pageByHref('/sarana'), tone: 'bg-yellow-400 text-ink' },
  { page: pageByHref('/kegiatan'), tone: 'bg-navy-900 text-white' },
];
---

<section class="bg-cream py-14 sm:py-24" aria-labelledby="jelajah-title">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Jelajahi Sekolah Kami</p>
      <h2 id="jelajah-title" class="mt-3 font-serif text-[1.6rem] leading-[1.18] text-navy-700 sm:mt-4 sm:text-[2.6rem]">
        Mulai dari mana saja yang ingin Anda ketahui.
      </h2>
    </div>

    <ul class="mt-8 grid grid-cols-2 gap-3 sm:mt-12 sm:gap-5 lg:grid-cols-4">
      {
        cards.map(({ page, tone }) => (
          <li data-reveal>
            <a href={page.href} class="group flex h-full flex-col overflow-hidden rounded-xl">
              <div class="aspect-[4/4.2] overflow-hidden sm:aspect-[4/3.6]">
                <Photo id={page.image} sizes="(min-width: 1024px) 290px, 50vw" widths={[300, 480, 640]} class="transition-transform duration-700 group-hover:scale-105" />
              </div>
              <div class:list={['flex flex-1 flex-col px-3 py-3 sm:px-5 sm:py-4', tone]}>
                <span class="flex items-center justify-between gap-2 font-serif text-[1.15rem] leading-tight sm:text-[1.5rem]">
                  {page.title}
                  <Icon name="arrow-right" size={18} class="shrink-0 transition-transform group-hover:translate-x-1" />
                </span>
                <span class="mt-2 hidden text-[13px] leading-relaxed opacity-85 sm:block">{page.description}</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
