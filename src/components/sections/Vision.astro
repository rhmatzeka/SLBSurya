---
import { Image, getImage } from 'astro:assets';
import logo from '../../assets/logo/logo.png';
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
import { photo, vision, videos } from '../../content/site';

const video = videos[1];
const poster = await getImage({ src: photo(video.poster).src, width: 960, format: 'webp' });
---

<section id="visi" class="relative overflow-hidden bg-navy-700 text-white" aria-labelledby="visi-title">
  <div class="absolute inset-0 lg:left-auto lg:w-1/2" aria-hidden="true">
    <Photo id="kegiatan/kebersamaan-1" sizes="(min-width: 1024px) 50vw, 100vw" />
    <div class="absolute inset-0 bg-navy-700/75 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-navy-900/55 lg:bg-navy-900/30"></div>
  </div>

  <div class="container-page relative grid gap-6 pb-40 pt-14 sm:gap-10 sm:py-20 lg:grid-cols-[auto_1fr] lg:gap-8 lg:py-24">
    <span class="grid h-12 w-12 place-items-center rounded-full bg-blue-500 font-serif text-4xl leading-none text-white" aria-hidden="true">
      “
    </span>

    <div class="max-w-[640px] lg:max-w-[500px]" data-reveal>
      <h2 id="visi-title" class="sr-only">Visi SLB Surya Wiyata</h2>
      <blockquote class="font-serif text-[1.25rem] leading-[1.35] sm:text-[1.85rem]">
        {vision}
      </blockquote>

      <div class="relative mt-8 flex flex-wrap items-center gap-4 pt-8 before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-[linear-gradient(to_right,rgba(255,255,255,.35)_50%,transparent_0)] before:bg-[length:8px_1px]">
        <span class="grid h-12 w-12 place-items-center rounded-full bg-white">
          <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} class="h-10 w-10" />
        </span>
        <div>
          <p class="text-sm font-semibold">Visi SLB Surya Wiyata</p>
          <p class="text-[13px] text-white/70">Tahun ajaran 2026/2027</p>
        </div>
        <a href="#visi-misi" class="btn-outline-light ml-0 py-2 sm:ml-2">Lihat Misi</a>
      </div>
    </div>

    <!-- Tombol putar dengan teks melingkar (seperti "Listen now" di referensi) -->
    <button
      type="button"
      class="group absolute bottom-10 right-4 grid h-[112px] w-[112px] place-items-center rounded-full bg-white sm:right-8 lg:bottom-auto lg:left-[calc(50%+120px)] lg:right-auto lg:top-1/2 lg:h-[132px] lg:w-[132px] lg:-translate-x-1/2 lg:-translate-y-1/2"
      aria-label={`Putar video: ${video.title}`}
      data-video-src={video.src}
      data-video-title={video.title}
      data-video-poster={poster.src}
    >
      <svg viewBox="0 0 132 132" class="absolute inset-0 h-full w-full animate-[spin_18s_linear_infinite] text-navy-900" aria-hidden="true">
        <defs>
          <path id="lingkar-teks" d="M66,66 m-52,0 a52,52 0 1,1 104,0 a52,52 0 1,1 -104,0" />
        </defs>
        <text class="fill-current text-[10.5px] font-semibold tracking-[0.2em]">
          <textPath href="#lingkar-teks">PUTAR VIDEO · PUTAR VIDEO · PUTAR VIDEO ·</textPath>
        </text>
      </svg>
      <span class="grid h-[70px] w-[70px] place-items-center rounded-full border-2 border-navy-900 bg-yellow-400 text-ink transition-transform group-hover:scale-105 lg:h-[84px] lg:w-[84px]">
        <Icon name="play" size={34} />
      </span>
    </button>
  </div>
</section>
