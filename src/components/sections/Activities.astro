---
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
import { activities } from '../../content/site';

interface Props {
  /** 'slider' untuk beranda, 'grid' untuk halaman Kegiatan */
  layout?: 'slider' | 'grid';
}
const { layout = 'slider' } = Astro.props;
const grid = layout === 'grid';
---

<section id="kegiatan" class="bg-cream py-14 sm:py-24" aria-labelledby="kegiatan-title" data-slider={grid ? undefined : true}>
  <div class="container-page">
    <div class="rule-dashed flex items-center justify-between pb-4">
      <h2 id="kegiatan-title" class="eyebrow">{grid ? 'Semua Kegiatan' : 'Kabar Kegiatan'}</h2>
      <div class:list={['flex gap-2', grid && 'hidden']}>
        <button
          type="button"
          class="grid h-9 w-9 place-items-center rounded-full border border-ink/70 text-ink transition hover:bg-white disabled:border-line disabled:bg-cream-200 disabled:text-ink/40"
          aria-label="Kegiatan sebelumnya"
          data-slider-prev
        >
          <Icon name="arrow-left" size={16} strokeWidth={2.2} />
        </button>
        <button
          type="button"
          class="grid h-9 w-9 place-items-center rounded-full border border-ink/70 text-ink transition hover:bg-white disabled:border-line disabled:bg-cream-200 disabled:text-ink/40"
          aria-label="Kegiatan berikutnya"
          data-slider-next
        >
          <Icon name="arrow-right" size={16} strokeWidth={2.2} />
        </button>
      </div>
    </div>

    <ul
      class:list={[
        'mt-6 gap-4 sm:mt-8 sm:gap-7',
        grid ? 'grid grid-cols-2 gap-y-8 lg:grid-cols-3' : 'no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth',
      ]}
      data-slider-track
    >
      {
        activities.map((a) => (
          <li
            class:list={[!grid && 'w-[calc((100%-1rem)/2)] shrink-0 snap-start sm:w-[calc((100%-1.75rem)/2)] lg:w-[calc((100%-3.5rem)/3)]']}
            data-slider-item
          >
            <a href="/galeri#kegiatan" class="group block">
              <div class="aspect-[1.52/1] overflow-hidden rounded-xl">
                <Photo
                  id={a.image}
                  sizes="(min-width: 1024px) 380px, 50vw"
                  widths={[400, 640, 800]}
                  class="transition-transform duration-700 group-hover:scale-105"
                />
              </div>
              <div class="mt-3 flex items-start justify-between gap-2 sm:mt-4 sm:gap-4">
                <div>
                  <h3 class="font-serif text-[0.95rem] leading-snug text-ink sm:text-[1.15rem]">{a.title}</h3>
                  <p class="mt-1 text-[12px] text-muted sm:mt-1.5 sm:text-[13px]">{a.tag}</p>
                </div>
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line text-ink transition group-hover:border-ink group-hover:bg-yellow-400 sm:h-8 sm:w-8">
                  <Icon name="chevron-right" size={16} strokeWidth={2.2} />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    {
      grid ? (
        <a href="/galeri" class="btn-yellow mt-10 px-6">
          Lihat Galeri Foto
          <Icon name="arrow-right" size={16} />
        </a>
      ) : (
        <a href="/kegiatan" class="btn-yellow mt-8 px-6 sm:mt-10">
          Lihat Semua Kegiatan
          <Icon name="arrow-right" size={16} />
        </a>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-slider-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-slider-next]');
    const item = root.querySelector<HTMLElement>('[data-slider-item]');
    if (!track || !item) return;
    const step = () => item.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0');
    const update = () => {
      if (prev) prev.disabled = track.scrollLeft <= 4;
      if (next) next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    prev?.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next?.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
