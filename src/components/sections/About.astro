---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo.png';
import Photo from '../ui/Photo.astro';
import Flower from '../ui/Flower.astro';
import Icon from '../ui/Icon.astro';
import { about, campuses } from '../../content/site';
---

<section id="tentang" class="relative overflow-hidden bg-cream pb-20 pt-16 sm:pt-20 lg:pb-24" aria-labelledby="tentang-title">
  <div class="container-page">
    <p class="eyebrow" data-reveal>Tentang Kami</p>
    <h2 id="tentang-title" class="h-section mt-4 max-w-[22ch]" data-reveal>
      Sekolah yang melayani setiap anak dengan kasih, kesabaran, dan harapan.
    </h2>

    <!-- Kolase: foto besar, kartu lokasi, foto tinggi (meniru kolase referensi) -->
    <div class="relative mt-10 grid grid-cols-2 gap-3 sm:mt-12 lg:grid-cols-[1.55fr_1fr_1fr] lg:gap-3">
      <div class="relative col-span-2 aspect-[4/3] overflow-hidden rounded-xl lg:col-span-1 lg:aspect-auto lg:h-[330px]" data-reveal>
        <Photo id="kegiatan/kebersamaan-2" sizes="(min-width: 1024px) 480px, 100vw" position="50% 35%" />
      </div>

      <div
        class="relative flex aspect-square flex-col justify-between overflow-hidden rounded-xl bg-blue-500 p-5 text-white sm:p-6 lg:aspect-auto lg:h-[330px]"
        data-reveal
      >
        <Flower class="absolute -right-10 -top-10 h-44 w-44 fill-white/10" />
        <Flower class="absolute -bottom-14 -left-12 h-40 w-40 fill-navy-700/25" />
        <div class="relative">
          <Image src={logo} alt="" width={64} height={64} densities={[1, 2]} class="h-14 w-14 sm:h-16 sm:w-16" />
        </div>
        <ul class="relative space-y-3">
          {
            campuses.map((c) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-yellow-400 text-ink">
                  <Icon name="pin" size={14} strokeWidth={2.2} />
                </span>
                <span>
                  <span class="block font-serif text-lg leading-tight sm:text-xl">{c.short}</span>
                  <span class="block text-xs text-white/85 sm:text-[13px]">{c.area}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative aspect-square overflow-hidden rounded-xl lg:row-span-2 lg:mt-24 lg:aspect-auto lg:h-[420px]" data-reveal>
        <Photo id="tentang/gedung-2" sizes="(min-width: 1024px) 320px, 50vw" position="30% 50%" />
      </div>

      <!-- Teks dua kolom -->
      <div class="col-span-2 mt-10 grid gap-10 sm:grid-cols-2 lg:mt-0 lg:pt-12 lg:pr-10">
        <div data-reveal>
          <p class="eyebrow">Sejarah Kami</p>
          {about.history.map((p) => <p class="mt-3 text-[16px] leading-[1.7] text-ink/85">{p}</p>)}
        </div>
        <div data-reveal>
          <p class="eyebrow">Layanan Kekhususan</p>
          <ul class="mt-4 space-y-3">
            {
              about.services.map((s) => (
                <li class="flex items-center gap-3">
                  <span class="grid h-9 min-w-9 place-items-center rounded-full bg-blue-50 px-2 text-xs font-bold text-blue-600 ring-1 ring-blue-100">
                    {s.code}
                  </span>
                  <span class="text-[16px]">
                    <strong class="font-semibold">{s.title}</strong>
                    {s.text && <span class="text-muted"> · {s.text}</span>}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-[16px] leading-[1.7] text-ink/85">
            Dikelola oleh <strong class="font-semibold">Yayasan Sosial Karya Kasih</strong>, dengan dua unit sekolah dari jenjang
            SDLB hingga SMALB.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-10" data-reveal>
      <a href="#visi-misi" class="btn-outline px-6 py-3">Visi & Misi</a>
    </div>
  </div>
</section>
