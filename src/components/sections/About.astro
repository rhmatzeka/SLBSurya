---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo.png';
import Photo from '../ui/Photo.astro';
import Flower from '../ui/Flower.astro';
import Icon from '../ui/Icon.astro';
import { about, campuses } from '../../content/site';

interface Props {
  /** Versi ringkas untuk beranda, dengan tombol ke halaman Tentang */
  compact?: boolean;
}
const { compact = false } = Astro.props;
const history = compact ? about.history.slice(0, 1) : about.history;
---

<section id="sejarah" class="relative overflow-hidden bg-cream pb-14 pt-12 sm:pb-20 sm:pt-20 lg:pb-24" aria-labelledby="tentang-title">
  <div class="container-page">
    <p class="eyebrow" data-reveal>Tentang Kami</p>
    <h2 id="tentang-title" class="h-section mt-4 max-w-[22ch]" data-reveal>
      Sekolah yang melayani setiap anak dengan kasih, kesabaran, dan harapan.
    </h2>

    <!-- Kolase: foto besar, kartu lokasi, foto tinggi (meniru kolase referensi) -->
    <div class="relative mt-7 grid grid-cols-[1.55fr_1fr] gap-2.5 sm:mt-12 sm:gap-3 lg:grid-cols-[1.55fr_1fr_1fr]">
      <div class="relative" data-reveal>
        <div class="aspect-[4/3.2] overflow-hidden rounded-lg sm:rounded-xl lg:aspect-auto lg:h-[330px]">
          <Photo id="kegiatan/kebersamaan-2" sizes="(min-width: 1024px) 480px, 60vw" position="50% 35%" />
        </div>
        <Flower
          class="pointer-events-none absolute -bottom-8 -left-3 z-10 h-14 w-14 fill-blue-500 sm:-bottom-11 sm:-left-5 sm:h-20 sm:w-20"
          ring
          ringClass="fill-yellow-400"
        />
      </div>

      <div
        class="relative flex flex-col justify-between overflow-hidden rounded-lg bg-blue-500 p-3 text-white sm:rounded-xl sm:p-6 lg:h-[330px]"
        data-reveal
      >
        <Flower class="absolute -right-10 -top-10 h-44 w-44 fill-white/10" />
        <Flower class="absolute -bottom-14 -left-12 h-40 w-40 fill-navy-700/25" />
        <div class="relative">
          <Image src={logo} alt="" width={64} height={64} densities={[1, 2]} class="h-10 w-10 sm:h-16 sm:w-16" />
        </div>
        <ul class="relative space-y-1.5 sm:space-y-3">
          {
            campuses.map((c) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-yellow-400 text-ink sm:h-6 sm:w-6">
                  <Icon name="pin" size={14} strokeWidth={2.2} />
                </span>
                <span>
                  <span class="block font-serif text-[15px] leading-tight sm:text-xl">{c.short}</span>
                  <span class="hidden text-[13px] text-white/85 sm:block">{c.area}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative hidden overflow-hidden rounded-xl lg:row-span-2 lg:mt-24 lg:block lg:h-[420px]" data-reveal>
        <Photo id="tentang/gedung-2" sizes="(min-width: 1024px) 320px, 50vw" position="30% 50%" />
      </div>

      <!-- Teks dua kolom -->
      <div class="col-span-2 mt-12 grid gap-9 sm:mt-10 sm:grid-cols-2 sm:gap-10 lg:mt-0 lg:pt-12 lg:pr-10">
        <div data-reveal>
          <p class="eyebrow">Sejarah Kami</p>
          {history.map((p) => <p class="mt-3 text-[16px] leading-[1.7] text-ink/85">{p}</p>)}
        </div>
        <div data-reveal>
          <p class="eyebrow">Layanan Kekhususan</p>
          <ul class="mt-4 space-y-3">
            {
              about.services.map((s) => (
                <li class="flex items-center gap-3">
                  <span class="grid h-9 min-w-9 place-items-center rounded-full bg-blue-50 px-2 text-xs font-bold text-blue-600 ring-1 ring-blue-100">
                    {s.code}
                  </span>
                  <span class="text-[16px]">
                    <strong class="font-semibold">{s.title}</strong>
                    {s.text && <span class="text-muted"> · {s.text}</span>}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class:list={['mt-5 text-[16px] leading-[1.7] text-ink/85', compact && 'hidden']}>
            Dikelola oleh <strong class="font-semibold">Yayasan Sosial Karya Kasih</strong>, dengan dua unit sekolah dari jenjang
            SDLB hingga SMALB.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-10" data-reveal>
      {
        compact ? (
          <a href="/tentang" class="btn-outline px-6 py-3">
            Selengkapnya tentang kami
            <Icon name="arrow-right" size={16} />
          </a>
        ) : (
          <a href="#visi-misi" class="btn-outline px-6 py-3">Visi & Misi</a>
        )
      }
    </div>
  </div>
</section>
