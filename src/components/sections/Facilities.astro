---
import Photo from '../ui/Photo.astro';
import Flower from '../ui/Flower.astro';
import Icon from '../ui/Icon.astro';
import { facilityGroups } from '../../content/site';
---

<section id="sarana" class="relative bg-cream pt-14 sm:pt-24" aria-labelledby="sarana-title">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Sarana Penunjang</p>
      <h2 id="sarana-title" class="h-section mt-4">Fasilitas yang aman, nyaman, dan menyenangkan.</h2>
      <p class="mt-6 text-[16px] leading-[1.75] text-ink/85">
        Dari green house hingga ruang tunggu orang tua, sarana di SLB Surya Wiyata disiapkan supaya setiap anak bisa belajar
        dengan tenang dan setiap orang tua merasa disambut.
      </p>
    </div>

    <div class="mt-8 flex flex-wrap gap-2 sm:mt-10" role="tablist" aria-label="Kategori sarana" data-tabs>
      {
        facilityGroups.map((g, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${g.id}`}
            aria-controls={`panel-${g.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="rounded-full border border-line bg-cream-200 px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-ink/40 aria-selected:border-ink/80 aria-selected:bg-yellow-400"
          >
            {g.tab}
          </button>
        ))
      }
    </div>
  </div>

  <div class="container-page relative z-10 mt-5">
    {
      facilityGroups.map((g, i) => (
        <div
          id={`panel-${g.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${g.id}`}
          class:list={['relative', i !== 0 && 'hidden']}
          data-tab-panel
        >
          <div class="grid grid-cols-2 gap-2 overflow-hidden rounded-xl bg-blue-100 p-2 sm:grid-cols-4 sm:grid-rows-2 sm:gap-2 sm:p-2.5 lg:h-[520px]">
            {g.images.map((img, k) => (
              <div
                class:list={[
                  'overflow-hidden rounded-lg',
                  k === 0 ? 'col-span-2 row-span-2 aspect-[16/11] sm:aspect-auto' : 'hidden aspect-square sm:block sm:aspect-auto',
                  k === 1 && 'sm:col-span-2',
                ]}
              >
                <Photo id={img} sizes={k === 0 ? '(min-width: 1024px) 600px, 100vw' : '(min-width: 1024px) 300px, 50vw'} />
              </div>
            ))}
          </div>

          <div class="relative mt-4 rounded-xl bg-white p-5 shadow-xl shadow-navy-900/10 sm:-mt-24 sm:ml-8 sm:max-w-[460px] sm:p-7">
            <h3 class="font-serif text-xl text-blue-600 sm:text-[1.7rem]">{g.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">{g.text}</p>
            <ul class="mt-4 grid gap-2 text-[15px]">
              {g.items.map((item) => (
                <li class="flex items-center gap-2">
                  <Icon name="check" size={16} strokeWidth={2.4} class="text-blue-500" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Barisan bunga (pengganti siluet pohon referensi) -->
  <div class="relative -mt-16 h-40 overflow-hidden bg-cream sm:-mt-28 sm:h-52" aria-hidden="true">
    <div class="absolute inset-x-0 bottom-0 h-16 bg-blue-100"></div>
    <div class="absolute inset-x-[-5%] bottom-6 flex items-end justify-between">
      {
        [90, 130, 70, 150, 100, 60, 140, 110, 80, 160, 95, 120, 70, 140, 100].map((s, i) => (
          <Flower class="shrink-0 fill-blue-100" style={`width:${s}px;height:${s}px;margin-bottom:${(i % 3) * -18}px`} />
        ))
      }
    </div>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>('[data-tabs]');
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-tab-panel]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => p.classList.toggle('hidden', k !== i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
      });
    });
  }
</script>
